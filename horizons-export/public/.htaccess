<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nunca reescrever assets estáticos para index.html.
  RewriteCond %{REQUEST_URI} (?:^|/)assets/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|txt|ico|png|jpe?g|gif|webp|svg|woff2?|ttf|eot|webmanifest)$ [NC]
  RewriteRule ^ - [L]

  # Manter arquivos e diretórios reais intactos.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback da SPA apenas para rotas da aplicação.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html nunca deve ficar preso em cache,
  # para evitar mismatch entre HTML antigo e chunks novos.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Assets fingerprinted podem ser cacheados agressivamente.
  <FilesMatch "\.(?:js|mjs|css|map|ico|png|jpe?g|gif|webp|svg|woff2?|ttf|eot|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Caso exista service worker, mantenha sempre fresco.
  <FilesMatch "^(?:service-worker|sw)\.js$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>