<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite static assets to index.html.
  RewriteCond %{REQUEST_URI} (?:^|/)assets/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|txt|ico|png|jpe?g|gif|webp|svg|woff2?|ttf|eot)$ [NC]
  RewriteRule ^ - [L]

  # Keep existing files/directories untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback only for application routes.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # Keep HTML fresh to avoid stale index -> missing chunk mismatches.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Fingerprinted static assets can be cached aggressively.
  <FilesMatch "\.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|webp|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
